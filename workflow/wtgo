#!/usr/bin/env bash

set -euo pipefail

# fzf-powered worktree selector. Prints the selected worktree path, or the main
# worktree path with `wtgo -`. A script can't cd its parent shell, so wrap it:
#   wtgo() { cd "$(command wtgo "$@")" || return; }
#
# --copy-env copies untracked .env files from the current worktree into the
# target. Existing files in the target are kept. stdout carries only the path,
# so all messages go to stderr.

to_main=false
copy_env=false

for arg in "$@"; do
    case "$arg" in
        -) to_main=true ;;
        --copy-env) copy_env=true ;;
        *) echo "wtgo: unknown argument: $arg" >&2; exit 2 ;;
    esac
done

if $to_main; then
    selected=$(git worktree list --porcelain | awk 'NR == 1 { sub(/^worktree /, ""); print }')
else
    selected=$(git worktree list | fzf --height=40% --reverse --prompt="worktree> " | awk '{print $1}')
fi

if [[ -z "$selected" ]]; then
    exit 1
fi

if $copy_env; then
    source_root=$(git rev-parse --show-toplevel)

    if [[ "$source_root" == "$selected" ]]; then
        echo "wtgo: already in target worktree, nothing to copy" >&2
    else
        while IFS= read -r -d '' file; do
            if [[ -e "$selected/$file" ]]; then
                echo "wtgo: skipped $file (exists)" >&2
                continue
            fi
            mkdir -p "$(dirname "$selected/$file")"
            cp -p "$source_root/$file" "$selected/$file"
            echo "wtgo: copied $file" >&2
        done < <(git -C "$source_root" ls-files -z --others -- \
            ':(glob)**/.env' ':(glob)**/.env.*' ':(exclude,glob)**/node_modules/**')
    fi
fi

echo "$selected"
