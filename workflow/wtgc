#!/usr/bin/env bash

set -euo pipefail

# fzf-powered branch and worktree cleanup. Pick one or more local branches or
# detached worktrees (Tab to multi-select), confirm, and each one loses its
# worktree, its local branch, and its branch on origin. Merged entries carry a
# check mark; a branch whose GitHub PR merged counts, so squash merges do too.
# --merged lists only those. -f forces past dirty worktrees and unmerged
# branches. --merge PATH (repeatable) copies PATH out of each worktree into the
# same path under the current worktree before deleting it, and --exclude PATH
# (or --merge '!PATH') leaves PATH out of the rescue. -v lists each file
# salvaged. -y skips the confirmation.

usage() { echo "usage: wtgc [-f] [-v] [-y] [--merged] [--merge [!]PATH]... [--exclude PATH]..." >&2; exit 2; }

add_merge() {
    local rel=${1%/}
    if [[ "$rel" == '!'* ]]; then
        excludes+=("${rel#!}")
    else
        merges+=("$rel")
    fi
}

force=false
verbose=false
yes=false
only_merged=false
merges=()
excludes=()
while (($#)); do
    case "$1" in
        -f) force=true ;;
        -v) verbose=true ;;
        -y) yes=true ;;
        --merged) only_merged=true ;;
        --merge) (($# > 1)) || usage; add_merge "$2"; shift ;;
        --merge=*) add_merge "${1#--merge=}" ;;
        --exclude) (($# > 1)) || usage; add_merge "!$2"; shift ;;
        --exclude=*) add_merge "!${1#--exclude=}" ;;
        *) usage ;;
    esac
    shift
done

main=$(git worktree list --porcelain | awk 'NR == 1 { sub(/^worktree /, ""); print }')
here=$(git rev-parse --show-toplevel)
default=$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default=${default#origin/}

# Running git from the main worktree means removing a linked worktree never
# pulls the directory out from under git itself.
g() { git -C "$main" "$@"; }

# Head commits of merged GitHub PRs, as "<branch> <sha>" lines. Empty when gh
# is missing or the remote isn't on GitHub.
pr_heads=$(command -v gh > /dev/null && cd "$main" &&
    gh pr list --state merged --limit 1000 --json headRefName,headRefOid \
        -q '.[] | "\(.headRefName) \(.headRefOid)"' 2>/dev/null || true)

# Prints how a ref is merged: "git" when it is in the main worktree's HEAD or
# origin's default branch, "pr" when its tip is part of a merged PR, or nothing.
# Its own upstream doesn't count, because wtgc deletes that too. For a detached
# worktree, $1 is its commit and $2 is empty.
merged_by() {
    local ref=$1 branch=$2 into name sha
    for into in HEAD ${default:+"origin/$default"}; do
        if g merge-base --is-ancestor "$ref" "$into" 2>/dev/null; then
            echo git
            return
        fi
    done
    [[ -n "$branch" ]] || return 0
    while read -r name sha; do
        if [[ "$name" == "$branch" ]] && g merge-base --is-ancestor "$ref" "$sha" 2>/dev/null; then
            echo pr
            return
        fi
    done <<< "$pr_heads"
}

# Copy every file under $1/$3 to $2/$3, skipping excluded paths. A file that
# already exists with different content is kept and the incoming copy lands
# beside it as <name>.<suffix>, so nothing from the worktree is lost.
rescue() {
    local src=$1 dest=$2 rel=$3 suffix=${4//\//-} file target ex
    [[ -e "$src/$rel" ]] || return 0
    while IFS= read -r -d '' file; do
        file=${file#"$src"/}
        for ex in ${excludes[@]+"${excludes[@]}"}; do
            [[ "$file" == $ex || "$file" == $ex/* ]] && continue 2
        done
        target="$dest/$file"
        file="$src/$file"
        mkdir -p "$(dirname "$target")"
        if [[ ! -e "$target" ]]; then
            cp -p "$file" "$target"
            if $verbose; then echo "salvaged: ${target#"$dest"/}"; fi
        elif ! cmp -s "$file" "$target"; then
            cp -p "$file" "$target.$suffix"
            echo "kept both: ${target#"$dest"/}.$suffix" >&2
        fi
    done < <(find "$src/$rel" -type f -print0)
}

protected=$(g worktree list --porcelain | awk -v main="$main" -v here="$here" '
    /^worktree / { path = substr($0, 10) }
    /^branch /   { if (path == main || path == here) { sub(/^branch refs\/heads\//, ""); print } }
')

# One tab-separated line per candidate: label, ref, branch, path. A detached
# worktree's ref is its commit. Empty fields hold "-", because read collapses
# runs of tabs.
candidates() {
    g for-each-ref --format='%(refname:short)%09%(worktreepath)' refs/heads |
        while IFS=$'\t' read -r branch path; do
            [[ "$branch" == "$default" ]] && continue
            grep -qxF -- "$branch" <<< "$protected" && continue
            printf '%s\t%s\t%s\t%s\n' "$branch" "$branch" "$branch" "${path:--}"
        done
    g worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10); head = "" }
        /^HEAD /     { head = substr($0, 6) }
        /^detached/  { print head "\t" path }
    ' | while IFS=$'\t' read -r head path; do
        [[ "$path" == "$main" || "$path" == "$here" ]] && continue
        printf '(detached %s)\t%s\t-\t%s\n' "${head:0:7}" "$head" "$path"
    done
}

selected=$(
    candidates |
        while IFS=$'\t' read -r label ref branch path; do
            how=$(merged_by "$ref" "${branch#-}")
            [[ -z "$how" ]] && $only_merged && continue
            mark=${how:+✓ $how}
            printf '%s\t%s\t%s\t%s\t%s\n' "$label" "${mark:--}" "$ref" "$branch" "$path"
        done |
        fzf --multi --height=40% --reverse --prompt="delete> " \
            --delimiter='\t' --with-nth=1,2,5
)

if [[ -z "$selected" ]]; then
    exit 1
fi

echo "To delete (worktree, local branch, origin branch):"
while IFS=$'\t' read -r label _ _ _ path; do
    path=${path#-}
    echo "  $label${path:+  ($path)}"
done <<< "$selected"
if ((${#merges[@]})); then
    echo "Rescuing into $here: ${merges[*]}"
fi
if ((${#excludes[@]})); then
    echo "Excluding: ${excludes[*]}"
fi

if ! $yes; then
    read -r -p "Proceed? [y/N] " answer < /dev/tty
    [[ "$answer" == [yY] ]] || exit 1
fi

worktree_flag=
if $force; then
    worktree_flag=--force
fi

status=0
while IFS=$'\t' read -r label mark ref branch path; do
    branch=${branch#-}
    path=${path#-}
    if ! $force && [[ "$mark" == - ]]; then
        echo "skipped $label: not fully merged (retry with -f)" >&2
        status=1
        continue
    fi

    if [[ -n "$path" ]]; then
        for rel in ${merges[@]+"${merges[@]}"}; do
            rescue "$path" "$here" "$rel" "${branch:-${ref:0:7}}"
        done
    fi

    if [[ -n "$path" ]] && ! g worktree remove $worktree_flag "$path"; then
        echo "skipped $label: worktree not removed (retry with -f)" >&2
        status=1
        continue
    fi

    [[ -n "$branch" ]] || continue

    # The merge check above already ran. -d would apply git's own test, which
    # refuses squash merges and branches merged only into origin's default.
    if ! g branch -D "$branch"; then
        echo "skipped $label: local branch not deleted (retry with -f)" >&2
        status=1
        continue
    fi

    if g ls-remote --exit-code --heads origin "$branch" > /dev/null 2>&1; then
        g push origin --delete "$branch" || status=1
    fi
done <<< "$selected"

exit "$status"
